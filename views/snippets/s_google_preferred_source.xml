<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_google_preferred_source" name="Google Preferred Source">
        <section class="s_google_preferred_source py-3 text-center" data-name="Google Preferred Source">
            <div class="container">
                <t t-set="pref_website" t-value="website or request.env['website'].get_current_website()"/>
                <t t-set="is_enabled" t-value="pref_website.has_google_preferred_source"/>
                <t t-set="theme" t-value="pref_website.google_preferred_source_theme or 'light'"/>
                <t t-set="lang" t-value="pref_website.google_preferred_source_lang"/>

                <div class="s_google_preferred_source_wrapper d-inline-block">
                    <!-- Official Google JS SDK, with an automatic fallback link if the -->
                    <!-- SDK doesn't render a badge within SDK_RENDER_TIMEOUT -->
                    <div google-add-preferred-source-btn=""
                         t-att-data-theme="theme"
                         t-att-data-lang="lang or None"
                         class="d-inline-block o_google_pref_sdk_slot"/>
                    <a t-att-href="pref_website.get_google_preferred_source_url()"
                       target="_blank" rel="noopener noreferrer"
                       class="btn btn-outline-primary rounded-pill px-4 py-2 d-inline-flex align-items-center gap-2 shadow-sm o_google_pref_deeplink o_google_pref_fallback d-none">
                        <i class="fa fa-google text-primary"/>
                        <span>Add as Preferred Source</span>
                        <i class="fa fa-external-link small ms-1 opacity-75"/>
                    </a>
                </div>
            </div>
        </section>
    </template>
</odoo>
