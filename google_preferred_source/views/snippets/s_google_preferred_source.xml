<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_google_preferred_source" name="Google Preferred Source">
        <section class="s_google_preferred_source py-3 text-center" data-name="Google Preferred Source">
            <div class="container">
                <t t-set="pref_website" t-value="website or request.env['website'].get_current_website()"/>
                <t t-set="is_enabled" t-value="pref_website.has_google_preferred_source"/>
                <t t-set="theme" t-value="pref_website.google_preferred_source_theme or 'light'"/>
                <t t-set="lang" t-value="pref_website.google_preferred_source_lang"/>

                <div class="s_google_preferred_source_wrapper d-inline-block">
                    <!-- Official Google JS SDK, with an automatic fallback link if the -->
                    <!-- SDK doesn't render a badge within SDK_RENDER_TIMEOUT -->
                    <div google-add-preferred-source-btn=""
                         t-att-data-theme="theme"
                         t-att-data-lang="lang or None"
                         class="d-inline-block o_google_pref_sdk_slot"/>
                    <a t-att-href="pref_website and pref_website.get_google_preferred_source_url() or 'https://www.google.com/preferences/source'"
                       target="_blank" rel="noopener noreferrer"
                       t-attf-class="o_google_pref_deeplink o_google_pref_fallback o_google_pref_theme_#{theme} d-none">
                        <svg class="o_google_g_logo" width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.616z"/>
                            <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/>
                            <path fill="#FBBC05" d="M3.964 10.707c-.18-.54-.282-1.117-.282-1.707s.102-1.167.282-1.707V4.961H.957C.347 6.175 0 7.55 0 9s.348 2.825.957 4.039l3.007-2.332z"/>
                            <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.961L3.964 7.293C4.672 5.166 6.656 3.58 9 3.58z"/>
                        </svg>
                        <span class="o_google_pref_text">Add to Preferred Sources</span>
                    </a>
                </div>
            </div>
        </section>
    </template>
</odoo>
