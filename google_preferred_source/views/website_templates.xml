<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Script injection into head of website layout -->
    <template id="website_layout_google_preferred_source" inherit_id="website.layout" priority="15">
        <head position="inside">
            <t t-set="curr_website" t-value="website or request.env['website'].get_current_website()"/>
            <t t-if="curr_website and curr_website.has_google_preferred_source">
                <t t-if="curr_website.google_preferred_source_mode == 'js'">
                    <script async="async" src="https://news.google.com/swg/js/v1/publisher.js"></script>
                </t>
            </t>
        </head>
        <!-- Auto Footer display -->
        <xpath expr="//footer" position="inside">
            <t t-set="curr_website" t-value="website or request.env['website'].get_current_website()"/>
            <t t-if="curr_website and curr_website.has_google_preferred_source and curr_website.google_preferred_source_auto_footer">
                <div class="container py-3 text-center o_footer_google_preferred_source border-top">
                    <div class="small text-muted mb-2">Follow our site on Google Search:</div>
                    <t t-call="google_preferred_source.s_google_preferred_source"/>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
